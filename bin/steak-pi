#!/bin/sh
# steak-pi — installer/updater for the Steak Pi pi-package (Pareto Cybernetics).
#
#   steak-pi install   Install or re-point the Steak Pi package for the pi CLI.
#   steak-pi update    First-class update: Homebrew upgrade + Pi re-pin (brew), a new
#                      versioned folder for release-folder installs, or the latest
#                      GitHub release re-pin (git/npm installs). --check reports (0 current, 10
#                      available, 1 failed); --skip, --auto and --checks write update preferences.
#                      --models refreshes Pi's cached model catalogs instead, including the
#                      providers extensions register (which `pi update --models` leaves as cached).
#   steak-pi status    Show what is installed and how it is managed.
#   steak-pi version   Print the CLI/package version.
#   steak-pi remove    Remove the Pi-side package.
#   steak-pi run ...   Launch pi with Steak Pi's Node runtime defaults.
#   steak-pi usap-api  Run explicit Claude API USAP waves (admit|dispatch|resume).
#   steak-pi local     Slot a local GGUF model into Pi: add | start | stop | status | ensure | release.
#   steak-pi routes    Task-class ranking for a job queue: rank | record | verdict | report.
#   steak-pi finish-guard-hook  Claude Code Stop hook: block a stop while requested work is open.
#
# Homebrew wrapper context sets STEAK_PI_LIBEXEC / STEAK_PI_OPT / STEAK_PI_FORMULA.
# Git and npm installs derive everything from this script's location.
set -u

# Generic opt-out honoured by npm and other toolchains this CLI invokes. An operator's explicit value wins.
export DO_NOT_TRACK="${DO_NOT_TRACK:-1}"

# Help must be handled before the hook, runtime setup, or any subcommand work.
is_help() { [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; }
if is_help "${2:-}"; then
  case "${1:-}" in
    install) echo 'usage: steak-pi install';;
    update) echo 'usage: steak-pi update [--check | --skip | --auto on|off|status | --checks on|off|status | --rollback [version] | --models]';;
    status) echo 'usage: steak-pi status';;
    version) echo 'usage: steak-pi version';;
    remove|uninstall) echo "usage: steak-pi $1";;
    usap-api) echo 'usage: steak-pi usap-api <admit|dispatch|resume> [options]';;
    local) echo 'usage: steak-pi local <add|start|stop|status|ensure|check|release> [arguments]';;
    routing) echo 'usage: steak-pi routing check [routing.json]';;
    routes) echo 'usage: steak-pi routes <rank|record|verdict|report> [options]';;
    env|lean-args|finish-guard-hook|help) echo "usage: steak-pi $1";;
    *) :;;
  esac
  case "${1:-}" in install|update|status|version|remove|uninstall|usap-api|local|routing|routes|env|lean-args|finish-guard-hook|help) exit 0;; esac
fi
if is_help "${3:-}"; then
  usage=''
  case "${1:-} ${2:-}" in
    'routing check') usage='routing check [routing.json]';;
    'usap-api admit') usage='usap-api admit [--tasks N] [--route R] [--role scout|worker|reviewer]';;
    'usap-api dispatch') usage='usap-api dispatch <wave.json> [--checkpoint-root DIR] [--out FILE]';;
    'usap-api resume') usage='usap-api resume <run-id> [--checkpoint-root DIR] [--out FILE]';;
    'local add') usage='local add <gguf path | owner/repo[:quant]> [--name id] [--ctx N] [--port N] [--lora <file | owner/repo[:file]>]... [--lora-scale S] [--no-adapter | --trust <publisher>] [-- extra llama-server args]';;
    'local start'|'local status') usage="local $2 [id]";;
    'local bypass') usage='local bypass <N>m|h|d [reason] | local bypass off';;
    'local adapter') usage='local adapter [id] [--trust [publisher]] | local adapter <id> --lora <file | owner/repo[:file]> | local adapter off [id]';;
    'local stop') usage='local stop';;
    'local ensure'|'local check'|'local release'|'local _supervise') usage="local $2 <id>";;
    'routes rank') usage='routes rank --class C [--candidate ENTRY[=HARNESS] ...] [--no-probe-marker] [--json]';;
    'routes record') usage='routes record --class C --run ID --task ID --route ENTRY --outcome pass|fail|unknown [options]';;
    'routes verdict') usage='routes verdict --run ID [--task ID] --outcome pass|fail --source verification|test-gate|operator [--note TEXT]';;
    'routes report') usage='routes report [--class C] [--json]';;
  esac
  if [ -n "$usage" ]; then echo "usage: steak-pi $usage"; exit 0; fi
fi

# Claude Code Stop hook (Hook JSON on stdin; a block verdict on stdout, nothing otherwise). Handled before
# any other setup so every stop stays fast, and it always exits 0: a missing node or a failing hook must
# never trap a session.
if [ "${1:-}" = "finish-guard-hook" ]; then
  if [ -n "${STEAK_PI_LIBEXEC:-}" ]; then hook_root=$STEAK_PI_LIBEXEC
  else hook_root=$(CDPATH= cd -P -- "$(dirname -- "$0")/.." 2>/dev/null && pwd -P); fi
  command -v node >/dev/null 2>&1 && [ -n "$hook_root" ] && node --no-warnings "$hook_root/src/finish-guard-hook.ts" 2>/dev/null
  exit 0
fi

REPO="github.com/michael-berardi/steak-pi"
PI_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
SETTINGS="$PI_DIR/settings.json"

say() { printf '%s\n' "$*"; }
die() { printf 'steak-pi: %s\n' "$*" >&2; exit 1; }

# Resolve the package root that ships this script.
if [ -n "${STEAK_PI_LIBEXEC:-}" ]; then
  PKG_ROOT="$STEAK_PI_LIBEXEC"
  BREW_MODE=1
else
  self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || die "cannot resolve script directory"
  PKG_ROOT="$self_dir/.."
  BREW_MODE=0
fi
PKG_ROOT=$(CDPATH= cd -- "$PKG_ROOT" && pwd -P) || die "cannot resolve package root"

pkg_version() {
  [ -f "$1/package.json" ] || return 1
  sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$1/package.json" | head -n 1
}

VERSION=$(pkg_version "$PKG_ROOT") || die "package.json missing next to $0"
GIT_SPEC="git:$REPO@v$VERSION"

need_pi() { command -v pi >/dev/null 2>&1 || die "pi CLI not found on PATH; install pi first (https://pi.dev)."; }

# The Pi-side spec currently installed, if any.
pi_spec() {
  [ -f "$SETTINGS" ] || return 1
  hit=$(grep -o "\"[^\"]*$REPO@[^\"]*\"" "$SETTINGS" | head -n 1)
  [ -n "$hit" ] && { printf '%s' "$hit" | tr -d '"'; return 0; }
  # Pi stores local paths relative to the agent directory, including Homebrew's opt path.
  hit=$(grep -o '"[^"]*opt/steak-pi/libexec"' "$SETTINGS" | head -n 1)
  [ -n "$hit" ] && { printf '%s' "$hit" | tr -d '"'; return 0; }
  # A release-folder entry may be relative to the Pi agent dir ("../../.local/share/steak-pi/releases/<v>/package").
  hit=$(grep -o "\"[^\"']*steak-pi/releases/[^\"/]*/package\"" "$SETTINGS" | head -n 1)
  [ -n "$hit" ] && { printf '%s' "$hit" | tr -d '"'; return 0; }
  hit=$(grep -o "\"/[^\"']*steak-pi[^\"]*\"" "$SETTINGS" | head -n 1)
  [ -n "$hit" ] && { printf '%s' "$hit" | tr -d '"'; return 0; }
  return 1
}

# The latest published release (one anonymous GET): sets TAG and NOTES (its first lines of release notes).
# STEAK_PI_LATEST_TAG pins a tag locally; STEAK_PI_UPDATE_API replaces only the endpoint (local fixtures).
latest_release() {
  TAG=""; NOTES=""
  if [ -n "${STEAK_PI_LATEST_TAG:-}" ]; then TAG=$STEAK_PI_LATEST_TAG; stable_tag; return 0; fi
  command -v curl >/dev/null 2>&1 || return 1
  response=$(curl -fsSL --max-time 20 -H 'User-Agent: steak-pi-update-check' \
    "${STEAK_PI_UPDATE_API:-https://api.github.com/repos/${REPO#github.com/}/releases/latest}") || return 1
  TAG=$(printf '%s\n' "$response" | grep -o '"tag_name": *"[^"]*"' | head -n 1 | cut -d '"' -f 4)
  stable_tag
  command -v node >/dev/null 2>&1 || return 0
  NOTES=$(printf '%s' "$response" | node -e '
    let s = ""; process.stdin.on("data", (d) => { s += d; }).on("end", () => {
      try { process.stdout.write(String(JSON.parse(s).body || "").split(/\r?\n/).filter((l) => l.trim()).slice(0, 6).join("\n")); } catch {}
    });' 2>/dev/null) || NOTES=""
}

# Only a stable vX.Y.Z tag counts as a release; anything else reads as none found.
stable_tag() {
  printf '%s\n' "${TAG#v}" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' || TAG=""
}

# True when $1 is a strictly newer stable x.y.z than $2 (a leading "v" is ignored; anything else is never newer).
is_newer() {
  printf '%s %s\n' "${1#v}" "${2#v}" | awk '
    $1 !~ /^[0-9]+\.[0-9]+\.[0-9]+$/ || $2 !~ /^[0-9]+\.[0-9]+\.[0-9]+$/ { exit 1 }
    { split($1, a, "."); split($2, b, "."); for (i = 1; i <= 3; i++) { if (a[i] + 0 > b[i] + 0) exit 0; if (a[i] + 0 < b[i] + 0) exit 1 } exit 1 }'
}

# Show current -> new and the notes; on a terminal, ask before installing. Explicit command = consent otherwise.
confirm_install() {
  say "Steak Pi $1 -> ${2#v}"
  [ -n "$NOTES" ] && printf '%s\n' "$NOTES" | sed 's/^/  /'
  [ -t 0 ] && [ -t 1 ] || return 0
  printf 'Install %s now? [Y/n] ' "${2#v}"
  read -r answer || answer=n
  case "$answer" in [nN]*) say "Not installed."; exit 0;; esac
}

# After an install on a terminal, ask once about automatic updates (the answer is remembered).
offer_auto() {
  [ -t 0 ] && [ -t 1 ] && command -v node >/dev/null 2>&1 || return 0
  node --no-warnings "$PKG_ROOT/src/update-cli.ts" --offer-auto || true
}

# Verify a release download against the published SHA256SUMS before touching any install.
fetch_file() {
  if command -v curl >/dev/null 2>&1; then curl -fsSL --max-time 120 -o "$2" "$1"
  elif command -v wget >/dev/null 2>&1; then wget -q -O "$2" "$1"
  else return 1; fi
}
sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
  else shasum -a 256 "$1" | cut -d' ' -f1; fi
}
expect_checksum() {
  want=$(awk -v n="$2" '{ f=$2; sub(/^\*/, "", f); if (f == n) print $1 }' "$3")
  [ -n "$want" ] || die "no checksum for $2 in SHA256SUMS; nothing was changed"
  [ "$(sha256_file "$1")" = "$want" ] || die "checksum mismatch for $2; nothing was changed"
}

# Steak Pi entries in Pi's settings whose identity differs from $1 (one per line). A local entry is printed as an absolute
# path resolved from the agent directory; it counts as Steak Pi when it is a release folder, Homebrew's libexec, or a folder
# whose package.json is named steak-pi. A git or npm entry of this repository prints as written. Exit 1: unreadable settings.
steak_entries_except() {
  [ -f "$SETTINGS" ] || return 0
  node -e '
    const fs = require("node:fs"); const path = require("node:path"); const os = require("node:os");
    const [file, target, repo] = process.argv.slice(1);
    let s; try { s = JSON.parse(fs.readFileSync(file, "utf8")); } catch (error) { console.error("steak-pi: " + file + ": " + error.message); process.exit(1); }
    const dir = path.dirname(file);
    const real = (p) => { try { return fs.realpathSync(p); } catch { return path.resolve(p); } };
    const remote = (src) => /^(git:|npm:|https?:|ssh:|git@)/.test(src);
    const abs = (src) => path.resolve(dir, src.replace(/^~(?=\/|$)/, os.homedir()));
    const ours = (src) => {
      if (remote(src)) return src.includes(repo);
      const p = abs(src);
      if (/steak-pi\/releases\/[^/]+\/package\/?$/.test(p) || /opt\/steak-pi\/libexec\/?$/.test(p)) return true;
      try { return JSON.parse(fs.readFileSync(path.join(p, "package.json"), "utf8")).name === "steak-pi"; } catch { return false; }
    };
    const id = (src) => remote(src) ? src.replace(/^git:/, "").replace(/@[^@/]*$/, "") : "local:" + real(abs(src));
    const want = id(target); const out = new Set();
    for (const p of Array.isArray(s.packages) ? s.packages : []) {
      const src = typeof p === "string" ? p : p?.source;
      if (typeof src !== "string" || !ours(src) || id(src) === want) continue;
      out.add(remote(src) ? src : abs(src));
    }
    if (out.size) console.log([...out].join("\n"));
  ' "$SETTINGS" "$1" "$REPO"
}

cmd_install() {
  need_pi
  if [ "$BREW_MODE" -eq 1 ]; then
    TARGET="$PKG_ROOT"
  else
    TARGET="$GIT_SPEC"
  fi
  # Every other Steak Pi entry goes, passed to `pi remove` as an absolute path: Pi resolves a local remove argument against
  # the current directory, not the agent directory its settings are relative to (2026-11-27: the relative 0.46.0 entry did not
  # match, the installer appended 0.46.1 next to it, and Pi kept loading 0.46.0).
  stale=$(steak_entries_except "$TARGET") || die "cannot read Pi's package list in $SETTINGS; nothing was changed"
  if [ -n "$stale" ]; then
    printf '%s\n' "$stale" | while IFS= read -r entry; do
      say "Replacing the existing pi package entry ($entry) to keep one canonical source..."
      pi remove "$entry" || die "pi remove $entry failed; Pi's settings still list it"
    done || exit 1
    stale=$(steak_entries_except "$TARGET") || stale=""
    [ -z "$stale" ] || die "Pi's settings still list another Steak Pi entry after pi remove: $stale"
  fi
  say "Installing Steak Pi $VERSION for pi:"
  say "  pi install $TARGET"
  exec pi install "$TARGET"
}

# Release-folder installs: <root>/releases/<version>/package, pinned in Pi settings by path.
# The update downloads the tagged release into a new sibling folder, installs its full dependency
# set (the extensions import Pi's own packages, so --omit=dev breaks loading), re-points settings
# atomically. Older releases go only when provably unused (src/update-releases.ts): one rollback stays.
release_root() {
  current=$(pi_spec) || return 1
  case "$current" in
    */steak-pi/releases/*/package) ;;
    *) return 1;;
  esac
  case "$current" in /*) abs="$current";; *) abs="$PI_DIR/$current";; esac
  abs=$(CDPATH= cd -- "$abs/../.." 2>/dev/null && pwd -P) || return 1
  printf '%s' "$abs"
}

# The version Pi loads: the pinned release folder when there is one (a Homebrew CLI can be older), else this CLI's.
loaded_version() {
  if release_root >/dev/null 2>&1; then
    v=$(pi_spec) || v=""; v=${v%/package}; v=${v##*/}
    [ -n "$v" ] && { printf '%s' "$v"; return 0; }
  fi
  printf '%s' "$VERSION"
}

# A release Pi can load: every package its extensions import (the peerDependencies, which npm ci installs as dev
# dependencies) is present in its own node_modules. Prints the missing names; returns 1 when any is missing.
release_missing_deps() {
  node -e '
    const fs = require("node:fs"); const path = require("node:path"); const dir = process.argv[1];
    let pkg; try { pkg = JSON.parse(fs.readFileSync(path.join(dir, "package.json"), "utf8")); } catch { console.log("package.json"); process.exit(1); }
    const names = Object.keys(pkg.peerDependencies || {});
    const missing = names.filter((n) => !fs.existsSync(path.join(dir, "node_modules", n, "package.json")));
    if (missing.length) { console.log(missing.join(", ")); process.exit(1); }
  ' "$1"
}

# Point the installer launcher shim at the same release folder. Only the exact marker authorizes a
# rewrite: a launcher from another installer (or no launcher at all) is left alone, and so is a marked
# one that runs a release under another releases root (another installation's launcher). The optional
# PATH line scripts/install.sh writes for its bundled Node is kept; the temp file is renamed into place.
# sync_installer_shim <root> <version>. Own variable names: the callers' $root, $ver and $target stay intact.
sync_installer_shim() {
  shim_path="${STEAK_PI_BIN_DIR:-$HOME/.local/bin}/steak-pi"
  shim_target="$1/$2/package/bin/steak-pi"
  node - "$shim_path" "$shim_target" "$1" <<'NODE' || die "could not re-point the installer shim at $2; Pi settings were already re-pointed"
const fs = require("node:fs");
const path = require("node:path");
const [shim, target, root] = process.argv.slice(2);
const marker = "steak-pi-installer-shim";
let stat;
try { stat = fs.lstatSync(shim); }
catch { console.log(`No installer shim at ${shim}; left it alone.`); process.exit(0); }
if (!stat.isFile()) {
  console.log(`Left ${shim} alone: it was not written by this installer.`);
  process.exit(0);
}
let current;
try { current = fs.readFileSync(shim, "utf8"); }
catch (error) { console.error(`steak-pi: could not read ${shim}: ${error.message}`); process.exit(1); }
if (!current.includes(marker)) {
  console.log(`Left ${shim} alone: it was not written by this installer.`);
  process.exit(0);
}
const q = String.fromCharCode(39);
// The same exec forms src/update-releases.ts reads: the installer's double quotes, or this rewrite's single quotes.
const execLine = current.split(/\r?\n/).map((line) => line.trim()).find((line) => line.startsWith("exec ")) || "";
const parts = execLine.match(/^exec\s+(?:"([^"]*)"|'((?:[^']|'\\'')*)'|(\S+))\s+"\$@"\s*$/);
const was = parts ? (parts[1] ?? (parts[2] === undefined ? parts[3] : parts[2].split(q + "\\" + q + q).join(q))) : "";
const real = (p) => { try { return fs.realpathSync(p); } catch { return path.resolve(p); } };
const wasAbs = was ? path.resolve(was.replace(/^~(?=\/)/, process.env.HOME || require("node:os").homedir())) : "";
if (!/\/\d+\.\d+\.\d+\/package\/bin\/steak-pi$/.test(wasAbs) ||
    real(path.dirname(path.dirname(path.dirname(path.dirname(wasAbs))))) !== real(root)) {
  console.log(`Left ${shim} alone: it does not run a release from ${root}.`);
  process.exit(0);
}
const pathLine = current.split(/\r?\n/).find((line) => /^PATH=".*:\$PATH"; export PATH$/.test(line)) || "";
const shellQuote = (value) => q + value.split(q).join(q + "\\" + q + q) + q;
const next = `#!/bin/sh\n# ${marker}\n${pathLine ? `${pathLine}\n` : ""}exec ${shellQuote(target)} "$@"\n`;
const tmp = `${shim}.steak-pi-update.tmp.${process.pid}`;
let created = false;
try {
  // Exclusive create: a path already at the temp name (or a symlink planted there) is never written through.
  fs.writeFileSync(tmp, next, { mode: stat.mode & 0o777, flag: "wx" });
  created = true;
  fs.chmodSync(tmp, stat.mode & 0o777);
  fs.renameSync(tmp, shim);
} catch (error) {
  if (created) try { fs.rmSync(tmp, { force: true }); } catch {}
  console.error(`steak-pi: could not write ${shim}: ${error.message}`);
  process.exit(1);
}
console.log(`Re-pointed installer shim ${shim} at ${target}.`);
NODE
}

# Re-point every known Pi agent directory at one release folder. The same releases root is the
# boundary: settings that pin another installation are never touched.
repoint_releases() {
  root="$1"; ver="$2"; verb="$3"
  pinned=$(pi_spec) || pinned=""
  pinned=${pinned%/package}; pinned=${pinned##*/}
  [ -n "$pinned" ] || die "cannot tell which release Pi loads from $SETTINGS; nothing was changed"
  # The target must run again before its rollback can go (a release rolled back from is not proven).
  rm -f "$root/$ver/.ran-at"
  # Each release that stops being pinned records when (.retired-at): only sessions started before then can still load it.
  node -e '
    const fs = require("node:fs"); const [file, root, ver] = process.argv.slice(1);
    const s = JSON.parse(fs.readFileSync(file, "utf8"));
    const rel = (p) => /steak-pi\/releases\/[^/]+\/package$/.test(typeof p === "string" ? p : p?.source ?? "");
    let hit = false;
    s.packages = (s.packages || []).map((p) => { if (!rel(p)) return p; hit = true;
      const src = typeof p === "string" ? p : p.source; const next = src.replace(/releases\/[^/]+\/package$/, "releases/" + ver + "/package");
      const old = src.match(/releases\/([^/]+)\/package$/)[1];
      if (old !== ver) try { fs.writeFileSync(root + "/" + old + "/.retired-at", Date.now() + "\n", { mode: 0o600 }); } catch {}
      return typeof p === "string" ? next : { ...p, source: next }; });
    if (!hit) { console.error("no release-folder entry in " + file); process.exit(1); }
    // Two release entries now naming one folder load the package twice: keep the first (2026-11-27).
    const seen = new Set();
    s.packages = s.packages.filter((p) => { if (!rel(p)) return true; const key = require("node:path").resolve(require("node:path").dirname(file), typeof p === "string" ? p : p.source);
      if (seen.has(key)) return false; seen.add(key); return true; });
    const tmp = file + ".steak-pi-update.tmp"; fs.writeFileSync(tmp, JSON.stringify(s, null, 2) + "\n", { mode: 0o600 }); fs.renameSync(tmp, file);
  ' "$SETTINGS" "$root" "$ver" || die "could not re-point $SETTINGS at $ver"
  # The same machine runs Pi from several known agent directories: the default ~/.pi/agent and one per UltraTerm provider
  # account (~/.ultraterm/provider-accounts/<provider>/<account>/agent). Each has its own settings.json, so updating only the
  # caller's left the others on the old release (2026-11-04: 4 of 5 stayed behind). Re-point every KNOWN directory whose
  # settings pin a release folder under this same releases root; unknown directories elsewhere are never touched.
  others=0
  for known in "$HOME/.pi/agent/settings.json" "${ULTRATERM_HOME:-$HOME/.ultraterm}"/provider-accounts/*/*/agent/settings.json; do
    [ -f "$known" ] && [ ! -L "$known" ] || continue
    [ "$(CDPATH= cd -- "$(dirname -- "$known")" 2>/dev/null && pwd -P)" = "$(CDPATH= cd -- "$(dirname -- "$SETTINGS")" 2>/dev/null && pwd -P)" ] && continue
    if node -e '
      const fs = require("node:fs"); const path = require("node:path"); const [file, root, ver] = process.argv.slice(1);
      let s; try { s = JSON.parse(fs.readFileSync(file, "utf8")); } catch { process.exit(2); }
      const dir = path.dirname(file); let hit = false;
      const real = (p) => { try { return fs.realpathSync(p); } catch { return path.resolve(p); } };
      const realRoot = real(root);
      // Same releases root only: <root>/<version>/package, wherever the entry is written relative from.
      const under = (src) => real(path.dirname(path.dirname(path.resolve(dir, src.replace(/^~(?=\/)/, process.env.HOME))))) === realRoot;
      s.packages = (s.packages || []).map((p) => { const src = typeof p === "string" ? p : p?.source ?? "";
        if (!/steak-pi\/releases\/[^/]+\/package$/.test(src) || !under(src)) return p; hit = true;
        const next = src.replace(/releases\/[^/]+\/package$/, "releases/" + ver + "/package");
        const old = src.match(/releases\/([^/]+)\/package$/)[1];
        if (old !== ver) try { fs.writeFileSync(path.join(root, old, ".retired-at"), Date.now() + "\n", { mode: 0o600 }); } catch {}
        return typeof p === "string" ? next : { ...p, source: next }; });
      if (!hit) process.exit(3);
      const seen = new Set();
      s.packages = s.packages.filter((p) => { const src = typeof p === "string" ? p : p?.source ?? "";
        if (!/steak-pi\/releases\/[^/]+\/package$/.test(src) || !under(src)) return true;
        const key = path.resolve(dir, src.replace(/^~(?=\/)/, process.env.HOME)); if (seen.has(key)) return false; seen.add(key); return true; });
      const tmp = file + ".steak-pi-update.tmp"; fs.writeFileSync(tmp, JSON.stringify(s, null, 2) + "\n", { mode: 0o600 }); fs.renameSync(tmp, file);
    ' "$known" "$root" "$ver" 2>/dev/null; then others=$((others + 1)); fi
  done
  [ "$others" -gt 0 ] && say "Also re-pointed $others other Pi agent setting$([ "$others" -eq 1 ] || echo s) on this machine to $ver."
  sync_installer_shim "$root" "$ver"
  say "Steak Pi $verb: $pinned -> $ver. Restart Pi or run /reload."
}

# Remove older releases that no known settings file pins and no running Pi session can load (one rollback stays).
prune_releases() {
  node --no-warnings "$PKG_ROOT/src/update-cli.ts" --prune "$1" "$2" 2>/dev/null || true
}

# Rolling back is a settings re-point to a release already on disk: no download, no deletion.
rollback_release_folder() {
  root="$1"; target="${2:-}"
  current=$(pi_spec) || die "$SETTINGS does not pin a release folder; nothing was rolled back"
  current=${current%/package}; current=${current##*/}
  if [ -z "$target" ]; then
    # The newest unpacked release older than the one Pi loads.
    for dir in "$root"/*/; do
      v=${dir%/}; v=${v##*/}
      is_newer "$current" "$v" && [ -f "$root/$v/package/package.json" ] || continue
      if [ -z "$target" ] || is_newer "$v" "$target"; then target=$v; fi
    done
  fi
  [ -n "$target" ] || die "no earlier release found under $root; pass a version explicitly"
  case "$target" in *[!0-9.]*) die "not a release version: $target";; esac
  [ -f "$root/$target/package/package.json" ] || die "release $target is not unpacked under $root; nothing was changed"
  [ "$(pkg_version "$root/$target/package")" = "$target" ] || die "release $target reports a different version; nothing was changed"
  if ! missing=$(release_missing_deps "$root/$target/package"); then
    die "release $target is missing dependencies ($missing); nothing was rolled back"
  fi
  repoint_releases "$root" "$target" "rolled back"
}

update_release_folder() {
  root="$1"; tag="$2"; ver="${tag#v}"
  command -v npm >/dev/null 2>&1 || die "npm not found; needed to install $tag's dependencies."
  dest="$root/$ver"
  # The release Pi loads now is the rollback, not this CLI's own version: a Homebrew CLI can be older than the release folder Pi
  # runs (2026-11-03: a 0.20.3 CLI updated a 0.21.0 install, "kept" a 0.20.3 folder that did not exist and deleted 0.21.0 under the
  # live sessions loading it, so none of them could start a Claude worker).
  pinned=$(pi_spec) || pinned=""
  pinned=${pinned%/package}; pinned=${pinned##*/}
  [ -n "$pinned" ] || die "cannot tell which release Pi loads from $SETTINGS; nothing was changed"
  if [ ! -f "$dest/package/package.json" ]; then
    [ ! -e "$dest" ] && [ ! -L "$dest" ] || die "release destination $dest already exists but is incomplete; preserved it"
    stage=$(mktemp -d "$root/.staging-$ver.XXXXXX") || die "cannot create a staging folder in $root"
    trap 'rm -rf "$stage"' EXIT INT TERM
    say "Downloading Steak Pi $tag..."
    if [ -n "${STEAK_PI_RELEASE_SOURCE:-}" ]; then
      # Local source override (release engineering and tests): the immutable tag is the pin.
      command -v git >/dev/null 2>&1 || die "git not found; needed to download $tag."
      src="$STEAK_PI_RELEASE_SOURCE"
      git clone -q --depth 1 --branch "$tag" "$src" "$stage/package" 2>/dev/null || die "download of $tag failed (git clone $src)"
      rm -rf "$stage/package/.git"
    else
      # Published releases ship a SHA256SUMS list. Verify the archive before any swap.
      base="${STEAK_PI_RELEASE_BASE:-https://github.com/${REPO#github.com/}/releases/download/$tag}"
      archive="steak-pi-$ver.tgz"
      fetch_file "$base/$archive" "$stage/$archive" || die "download of $archive failed; nothing was changed"
      fetch_file "$base/SHA256SUMS" "$stage/SHA256SUMS" || die "download of SHA256SUMS failed; nothing was changed"
      expect_checksum "$stage/$archive" "$archive" "$stage/SHA256SUMS"
      mkdir "$stage/unpack" || die "cannot unpack $archive"
      tar -xzf "$stage/$archive" -C "$stage/unpack" || die "cannot unpack $archive; nothing was changed"
      [ -f "$stage/unpack/package/package.json" ] || die "$archive has no package/package.json; nothing was changed"
      mv "$stage/unpack/package" "$stage/package" || die "cannot stage $archive"
    fi
    say "Installing dependencies..."
    (cd "$stage/package" && npm ci --ignore-scripts --no-audit --no-fund >/dev/null 2>&1) || die "npm ci failed for $tag in $stage/package; nothing was changed"
    [ "$(pkg_version "$stage/package")" = "$ver" ] || die "downloaded package does not report version $ver"
    mkdir "$dest" && chmod 700 "$dest" && mv "$stage/package" "$dest/package" || die "cannot move $tag into $dest"
    rm -rf "$stage"; trap - EXIT INT TERM
  fi
  # Never point Pi at a release it cannot load (2026-11-11: 0.27.2 existed with its source but an empty node_modules, the
  # pre-existing folder skipped the install above, settings were re-pointed and every Pi launch failed for 16 minutes).
  # An existing release without its dependencies gets them from its own lockfile; if they are still missing, stop here.
  if ! missing=$(release_missing_deps "$dest/package"); then
    say "Release $ver is missing dependencies ($missing); installing them..."
    (cd "$dest/package" && npm ci --ignore-scripts --no-audit --no-fund >/dev/null 2>&1) ||
      die "npm ci failed in $dest/package; Pi settings were not changed and still load $pinned"
    missing=$(release_missing_deps "$dest/package") ||
      die "release $ver still lacks $missing after npm ci; Pi settings were not changed and still load $pinned"
  fi
  repoint_releases "$root" "$ver" "updated"
  prune_releases "$root" "$ver"
}

# Refresh Pi's cached model catalogs (models-store.json in the Pi agent directory) with every extension loaded.
# `pi update --models` builds its model runtime without extensions, so a provider an extension registers keeps its
# cached row and the command still reports success. This runs the installed pi with the operator's packages loaded.
cmd_update_models() {
  need_pi
  command -v node >/dev/null 2>&1 || die "node not found on PATH."
  exec node --no-warnings "$PKG_ROOT/src/update-models.ts"
}

cmd_update() {
  for arg in "$@"; do
    [ "$arg" = "--models" ] && cmd_update_models
  done
  case "${1:-}" in
    --check|--skip|--auto|--checks)
      # Report and preference flags share the Pi extension's check, cache and config (src/update-cli.ts).
      command -v node >/dev/null 2>&1 || die "node not found on PATH."
      flag="$1"; shift
      case "$flag" in
        --check|--skip) exec node --no-warnings "$PKG_ROOT/src/update-cli.ts" "$flag" "$(loaded_version)";;
        *) exec node --no-warnings "$PKG_ROOT/src/update-cli.ts" "$flag" "$@";;
      esac
      ;;
    --rollback)
      if root=$(release_root); then
        shift; rollback_release_folder "$root" "${1:-}"; exit 0
      fi
      die "--rollback is available for release-folder installs only; reinstall a version with your package manager"
      ;;
  esac
  if root=$(release_root); then
    latest_release || die "cannot reach GitHub to find the latest release."
    [ -n "$TAG" ] || die "no published x.y.z release found."
    have=$(loaded_version)
    if ! is_newer "$TAG" "$have"; then say "Steak Pi is up to date ($have)."; exit 0; fi
    confirm_install "$have" "$TAG"
    update_release_folder "$root" "$TAG"
    offer_auto
    exit 0
  fi
  if [ "$BREW_MODE" -eq 1 ]; then
    command -v brew >/dev/null 2>&1 || die "brew not found; this copy is Homebrew-managed."
    # Homebrew analytics are off for this update unless the operator set a value.
    HOMEBREW_NO_ANALYTICS="${HOMEBREW_NO_ANALYTICS:-1}"; export HOMEBREW_NO_ANALYTICS
    say "Upgrading Homebrew formula ${STEAK_PI_FORMULA:-steak-pi}..."
    brew update || die "brew update failed."
    brew upgrade "${STEAK_PI_FORMULA:-steak-pi}" || say "Homebrew reports no upgrade; continuing."
    NEW_LIBEXEC="$STEAK_PI_OPT/libexec"
    NEW_VERSION=$(pkg_version "$NEW_LIBEXEC") || die "upgraded formula package not found at $NEW_LIBEXEC"
    [ "$NEW_VERSION" = "$VERSION" ] && say "Steak Pi is up to date ($VERSION)." || say "Steak Pi upgraded: $VERSION -> $NEW_VERSION."
    current=$(pi_spec) || current=""
    case "$current" in
      */opt/steak-pi*)
        say "Pi points at the managed opt path ($current); it picks up the upgrade automatically."
        exit 0
        ;;
      "git:$REPO@"*)
        say "Re-pinning the pi package to v$NEW_VERSION:"
        say "  pi install git:$REPO@v$NEW_VERSION"
        exec pi install "git:$REPO@v$NEW_VERSION"
        ;;
      "")
        say "Pi-side integration is not installed. Run 'steak-pi install' to add it."
        exit 0
        ;;
      *)
        say "Unrecognized pi spec '$current'; leaving it untouched."
        exit 0
        ;;
    esac
  fi
  need_pi
  say "Resolving the latest Steak Pi release..."
  latest_release || die "cannot reach GitHub. Install a release manually: pi install $GIT_SPEC"
  [ -n "$TAG" ] || die "no published x.y.z release found. Install manually: pi install $GIT_SPEC"
  if ! is_newer "$TAG" "$VERSION"; then say "Steak Pi is up to date ($VERSION)."; exit 0; fi
  confirm_install "$VERSION" "$TAG"
  say "Updating pi package to $TAG:"
  say "  pi install git:$REPO@$TAG"
  pi install "git:$REPO@$TAG" || exit $?
  offer_auto
}

cmd_status() {
  mode="git/npm install"; [ "$BREW_MODE" -eq 1 ] && mode="Homebrew (${STEAK_PI_FORMULA:-steak-pi})"
  say "steak-pi CLI      $VERSION  [$mode]"
  say "package root      $PKG_ROOT"
  say "pi settings       $SETTINGS"
  if current=$(pi_spec); then
    root="${current#git:$REPO@}"
    case "$current" in
      git:*) loc="$PI_DIR/git/$REPO";;
      /*) loc="$current";;
      *) loc="$PI_DIR/$current";;
    esac
    pver=$(pkg_version "$loc" 2>/dev/null || echo "unknown")
    say "pi integration    $current  (v$pver)"
  else
    say "pi integration    not installed — run 'steak-pi install'"
  fi
}

cmd_version() {
  say "steak-pi $VERSION (Pareto Cybernetics)"
}

cmd_remove() {
  # Uninstall leaves no update debris: cache, preference section and auto-update log.
  if command -v node >/dev/null 2>&1; then
    node --no-warnings "$PKG_ROOT/src/update-cli.ts" --cleanup >/dev/null 2>&1 || true
  fi
  need_pi
  if current=$(pi_spec); then
    say "Removing $current from pi..."
    exec pi remove "$current"
  fi
  say "No Steak Pi package found in $SETTINGS."
}

# Node runtime defaults for pi sessions. Each applies only when the operator
# has not set it. Measured on Pi 0.86 with the full package, scripted model:
#   compile cache      ~0.1 s faster start after the first launch, -10 MB
#   MALLOC_ARENA_MAX=2 fewer glibc arenas across libuv/V8 helper threads
#   semi-space 2 MB    smaller young generation; idle PSS -12%, 8-worker
#                      fan-out peak RSS 164 -> 125 MB, no measured slowdown
# Child processes must not spawn a versioned Homebrew keg path: `brew upgrade` deletes it under a running session
# (2026-11-18: `spawn .../Cellar/node@22/<old>/bin/node ENOENT`). Export the stable path node was found at, mapping a
# <prefix>/Cellar/<formula>/<version>/bin/node path to <prefix>/opt/<formula>/bin/node. An explicit STEAK_PI_NODE wins.
stable_node_env() {
  [ -n "${STEAK_PI_NODE:-}" ] && return 0
  found=$(command -v node 2>/dev/null) || return 0
  case "$found" in
    */Cellar/*/bin/node)
      prefix=${found%%/Cellar/*}; rest=${found#*/Cellar/}; formula=${rest%%/*}
      [ -x "$prefix/opt/$formula/bin/node" ] && found="$prefix/opt/$formula/bin/node";;
  esac
  case "$found" in /*) STEAK_PI_NODE="$found"; export STEAK_PI_NODE;; esac
}

run_env() {
  stable_node_env
  # Pi's install telemetry (pi.dev report-install plus provider attribution headers) stays off for
  # sessions launched here unless the operator explicitly enables it.
  if [ -z "${PI_TELEMETRY:-}" ]; then
    PI_TELEMETRY=0; export PI_TELEMETRY
  fi
  # Offline at startup: no Pi version check, tool download or catalog refresh until the operator asks.
  # Model calls to configured providers still work; PI_OFFLINE=0 restores Pi's online startup defaults.
  if [ -z "${PI_OFFLINE:-}" ]; then
    PI_OFFLINE=1; export PI_OFFLINE
  fi
  if [ -z "${NODE_COMPILE_CACHE:-}" ] && [ -z "${NODE_DISABLE_COMPILE_CACHE:-}" ]; then
    NODE_COMPILE_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/steak-pi/node-compile-cache"
    export NODE_COMPILE_CACHE
  fi
  if [ -z "${MALLOC_ARENA_MAX:-}" ]; then
    MALLOC_ARENA_MAX=2
    export MALLOC_ARENA_MAX
  fi
  case " ${NODE_OPTIONS:-} " in
    *" --max-semi-space-size"*) ;;
    *) NODE_OPTIONS="--max-semi-space-size=2${NODE_OPTIONS:+ $NODE_OPTIONS}"; export NODE_OPTIONS;;
  esac
}

# Steak Pi is one adaptive package: a one-shot run already starts light and loads the dispatch and todo tools when the
# work needs them, so plain `run` is the way to run it. --lean (first argument only) is still accepted and forces the
# light shape for the whole run: no dispatch, hub or todo tool (they cannot load), and the short-reasoning line in the
# working rules. Everything else (guards, working rules, compaction) stays on. STEAK_PI_WORK_RULES_BRIEF=0 keeps the line out.
LEAN_TOOLS="ultraterm_subagents,ultraterm_hub,todo"

cmd_run() {
  need_pi
  run_env
  if [ "${1:-}" = "--lean" ]; then
    shift
    STEAK_PI_WORK_RULES_BRIEF="${STEAK_PI_WORK_RULES_BRIEF:-1}"
    export STEAK_PI_WORK_RULES_BRIEF
    exec pi --exclude-tools "$LEAN_TOOLS" "$@"
  fi
  exec pi "$@"
}

cmd_usap_api() {
  command -v node >/dev/null 2>&1 || die "node not found on PATH."
  exec node "$PKG_ROOT/scripts/usap-claude-api.ts" "$@"
}

cmd_routing() {
  command -v node >/dev/null 2>&1 || die "node not found on PATH."
  [ "${1:-}" = check ] || die "usage: steak-pi routing check [routing.json]"
  shift
  exec node --no-warnings "$PKG_ROOT/src/routing-check.ts" "$@"
}

cmd_routes() {
  command -v node >/dev/null 2>&1 || die "node not found on PATH."
  exec node --no-warnings "$PKG_ROOT/src/routes-cli.ts" "$@"
}

cmd_local() {
  command -v node >/dev/null 2>&1 || die "node not found on PATH."
  exec node --no-warnings "$PKG_ROOT/src/local/main.ts" "$@"
}

case "${1:-help}" in
  install) cmd_install;;
  update)  shift; cmd_update "$@";;
  status)  cmd_status;;
  version|--version|-V) cmd_version;;
  remove|uninstall) cmd_remove;;
  run) shift; cmd_run "$@";;
  usap-api) shift; cmd_usap_api "$@";;
  local) shift; cmd_local "$@";;
  routing) shift; cmd_routing "$@";;
  routes) shift; cmd_routes "$@";;
  env) run_env; say "NODE_COMPILE_CACHE=$NODE_COMPILE_CACHE"; say "MALLOC_ARENA_MAX=$MALLOC_ARENA_MAX"; say "NODE_OPTIONS=$NODE_OPTIONS";;
  lean-args) say "--exclude-tools $LEAN_TOOLS";;
  help|--help|-h|*)
    say "usage: steak-pi <install|update|status|version|remove|run|usap-api|local|routing|routes|finish-guard-hook|env|lean-args>"
    say "  install   add Steak Pi to the pi coding agent (or re-point at this copy)"
    say "  update    install the latest release (--check reports 0 current / 10 available / 1 failed; --skip hides this version; --auto on|off|status; --checks on|off|status; --rollback [version]; --models refreshes Pi's model catalogs)"
    say "  status    show installed versions and management mode"
    say "  version   print the CLI/package version"
    say "  remove    remove the pi-side package"
    say "  run       launch pi with Steak Pi's Node runtime defaults (args pass through; one package, no mode to pick; --lean first is still accepted and keeps the whole run light)"
    say "  usap-api  run explicit Claude API USAP waves: admit | dispatch <wave.json> | resume <run-id>"
    say "  local     slot in a local GGUF model (its harness adapter, when one exists, comes with it): add <gguf|owner/repo:quant> | adapter | start | stop | status | ensure <id> | release <id>"
    say "  routing   check [file]: validate routing.json exactly as every Pi turn does (run it before saving an edit)"
    say "  routes    rank | record | verdict | report: the task-class ranking and its evidence store, for a job queue outside Pi"
    say "  finish-guard-hook  Claude Code Stop hook: block a stop while requested work is open (reads hook JSON on stdin)"
    say "  env       print the runtime defaults 'run' would apply"
    case "${1:-help}" in help|--help|-h) :;; *) die "unknown command '$1'";; esac
    ;;
esac
