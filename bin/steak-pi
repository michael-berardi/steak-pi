#!/bin/sh
# steak-pi — installer/updater for the Steak Pi pi-package (Pareto Cybernetics).
#
#   steak-pi install   Install or re-point the Steak Pi package for the pi CLI.
#   steak-pi update    First-class update: Homebrew upgrade + Pi re-pin (brew), a new
#                      versioned folder for release-folder installs, or the latest
#                      GitHub release re-pin (git/npm installs). --check only reports.
#   steak-pi status    Show what is installed and how it is managed.
#   steak-pi version   Print the CLI/package version.
#   steak-pi remove    Remove the Pi-side package.
#   steak-pi run ...   Launch pi with Steak Pi's Node runtime defaults.
#   steak-pi usap-api  Run explicit Claude API USAP waves (admit|dispatch|resume).
#   steak-pi local     Slot a local GGUF model into Pi: add | start | stop | status | ensure | release.
#   steak-pi finish-guard-hook  Claude Code Stop hook: block a stop while requested work is open.
#
# Homebrew wrapper context sets STEAK_PI_LIBEXEC / STEAK_PI_OPT / STEAK_PI_FORMULA.
# Git and npm installs derive everything from this script's location.
set -u

# Claude Code Stop hook (Hook JSON on stdin; a block verdict on stdout, nothing otherwise). Handled before
# any other setup so every stop stays fast, and it always exits 0: a missing node or a failing hook must
# never trap a session.
if [ "${1:-}" = "finish-guard-hook" ]; then
  if [ -n "${STEAK_PI_LIBEXEC:-}" ]; then hook_root=$STEAK_PI_LIBEXEC
  else hook_root=$(CDPATH= cd -P -- "$(dirname -- "$0")/.." 2>/dev/null && pwd -P); fi
  command -v node >/dev/null 2>&1 && [ -n "$hook_root" ] && node --no-warnings "$hook_root/src/finish-guard-hook.ts" 2>/dev/null
  exit 0
fi

REPO="github.com/michael-berardi/steak-pi"
PI_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
SETTINGS="$PI_DIR/settings.json"

say() { printf '%s\n' "$*"; }
die() { printf 'steak-pi: %s\n' "$*" >&2; exit 1; }

# Resolve the package root that ships this script.
if [ -n "${STEAK_PI_LIBEXEC:-}" ]; then
  PKG_ROOT="$STEAK_PI_LIBEXEC"
  BREW_MODE=1
else
  self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || die "cannot resolve script directory"
  PKG_ROOT="$self_dir/.."
  BREW_MODE=0
fi
PKG_ROOT=$(CDPATH= cd -- "$PKG_ROOT" && pwd -P) || die "cannot resolve package root"

pkg_version() {
  [ -f "$1/package.json" ] || return 1
  sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$1/package.json" | head -n 1
}

VERSION=$(pkg_version "$PKG_ROOT") || die "package.json missing next to $0"
GIT_SPEC="git:$REPO@v$VERSION"

need_pi() { command -v pi >/dev/null 2>&1 || die "pi CLI not found on PATH; install pi first (https://pi.dev)."; }

# The Pi-side spec currently installed, if any.
pi_spec() {
  [ -f "$SETTINGS" ] || return 1
  hit=$(grep -o "\"[^\"]*$REPO@[^\"]*\"" "$SETTINGS" | head -n 1)
  [ -n "$hit" ] && { printf '%s' "$hit" | tr -d '"'; return 0; }
  # Pi stores local paths relative to the agent directory, including Homebrew's opt path.
  hit=$(grep -o '"[^"]*opt/steak-pi/libexec"' "$SETTINGS" | head -n 1)
  [ -n "$hit" ] && { printf '%s' "$hit" | tr -d '"'; return 0; }
  # A release-folder entry may be relative to the Pi agent dir ("../../.local/share/steak-pi/releases/<v>/package").
  hit=$(grep -o "\"[^\"']*steak-pi/releases/[^\"/]*/package\"" "$SETTINGS" | head -n 1)
  [ -n "$hit" ] && { printf '%s' "$hit" | tr -d '"'; return 0; }
  hit=$(grep -o "\"/[^\"']*steak-pi[^\"]*\"" "$SETTINGS" | head -n 1)
  [ -n "$hit" ] && { printf '%s' "$hit" | tr -d '"'; return 0; }
  return 1
}

latest_tag() {
  [ -n "${STEAK_PI_LATEST_TAG:-}" ] && { printf '%s\n' "$STEAK_PI_LATEST_TAG"; return 0; }
  command -v curl >/dev/null 2>&1 || return 1
  response=$(curl -fsSL --max-time 20 "https://api.github.com/repos/${REPO#github.com/}/releases/latest") || return 1
  printf '%s\n' "$response" |
    grep -o '"tag_name": *"[^"]*"' | head -n 1 | cut -d '"' -f 4
}

cmd_install() {
  need_pi
  if [ "$BREW_MODE" -eq 1 ]; then
    TARGET="$PKG_ROOT"
  else
    TARGET="$GIT_SPEC"
  fi
  current=$(pi_spec) || current=""
  if [ -n "$current" ] && [ "$current" != "$TARGET" ]; then
    say "Replacing the existing pi package entry ($current) to keep one canonical source..."
    pi remove "$current" || say "pi remove reported nothing to do; continuing."
  fi
  say "Installing Steak Pi $VERSION for pi:"
  say "  pi install $TARGET"
  exec pi install "$TARGET"
}

# Release-folder installs: <root>/releases/<version>/package, pinned in Pi settings by path.
# The update downloads the tagged release into a new sibling folder, installs its full dependency
# set (the extensions import Pi's own packages, so --omit=dev breaks loading), re-points settings
# atomically. All existing releases are retained: any agent directory may pin one.
release_root() {
  current=$(pi_spec) || return 1
  case "$current" in
    */steak-pi/releases/*/package) ;;
    *) return 1;;
  esac
  case "$current" in /*) abs="$current";; *) abs="$PI_DIR/$current";; esac
  abs=$(CDPATH= cd -- "$abs/../.." 2>/dev/null && pwd -P) || return 1
  printf '%s' "$abs"
}

# A release Pi can load: every package its extensions import (the peerDependencies, which npm ci installs as dev
# dependencies) is present in its own node_modules. Prints the missing names; returns 1 when any is missing.
release_missing_deps() {
  node -e '
    const fs = require("node:fs"); const path = require("node:path"); const dir = process.argv[1];
    let pkg; try { pkg = JSON.parse(fs.readFileSync(path.join(dir, "package.json"), "utf8")); } catch { console.log("package.json"); process.exit(1); }
    const names = Object.keys(pkg.peerDependencies || {});
    const missing = names.filter((n) => !fs.existsSync(path.join(dir, "node_modules", n, "package.json")));
    if (missing.length) { console.log(missing.join(", ")); process.exit(1); }
  ' "$1"
}

update_release_folder() {
  root="$1"; tag="$2"; ver="${tag#v}"
  command -v git >/dev/null 2>&1 || die "git not found; needed to download $tag."
  command -v npm >/dev/null 2>&1 || die "npm not found; needed to install $tag's dependencies."
  dest="$root/$ver"
  # The release Pi loads now is the rollback, not this CLI's own version: a Homebrew CLI can be older than the release folder Pi
  # runs (2026-11-03: a 0.20.3 CLI updated a 0.21.0 install, "kept" a 0.20.3 folder that did not exist and deleted 0.21.0 under the
  # live sessions loading it, so none of them could start a Claude worker).
  pinned=$(pi_spec) || pinned=""
  pinned=${pinned%/package}; pinned=${pinned##*/}
  [ -n "$pinned" ] || die "cannot tell which release Pi loads from $SETTINGS; nothing was changed"
  if [ ! -f "$dest/package/package.json" ]; then
    [ ! -e "$dest" ] && [ ! -L "$dest" ] || die "release destination $dest already exists but is incomplete; preserved it"
    stage=$(mktemp -d "$root/.staging-$ver.XXXXXX") || die "cannot create a staging folder in $root"
    trap 'rm -rf "$stage"' EXIT INT TERM
    say "Downloading Steak Pi $tag..."
    src="${STEAK_PI_RELEASE_SOURCE:-https://$REPO.git}"
    git clone -q --depth 1 --branch "$tag" "$src" "$stage/package" 2>/dev/null || die "download of $tag failed (git clone $src)"
    rm -rf "$stage/package/.git"
    say "Installing dependencies..."
    (cd "$stage/package" && npm ci --ignore-scripts --no-audit --no-fund >/dev/null 2>&1) || die "npm ci failed for $tag in $stage/package; nothing was changed"
    [ "$(pkg_version "$stage/package")" = "$ver" ] || die "downloaded package does not report version $ver"
    mkdir "$dest" && chmod 700 "$dest" && mv "$stage/package" "$dest/package" || die "cannot move $tag into $dest"
    rm -rf "$stage"; trap - EXIT INT TERM
  fi
  # Never point Pi at a release it cannot load (2026-11-11: 0.27.2 existed with its source but an empty node_modules, the
  # pre-existing folder skipped the install above, settings were re-pointed and every Pi launch failed for 16 minutes).
  # An existing release without its dependencies gets them from its own lockfile; if they are still missing, stop here.
  if ! missing=$(release_missing_deps "$dest/package"); then
    say "Release $ver is missing dependencies ($missing); installing them..."
    (cd "$dest/package" && npm ci --ignore-scripts --no-audit --no-fund >/dev/null 2>&1) ||
      die "npm ci failed in $dest/package; Pi settings were not changed and still load $pinned"
    missing=$(release_missing_deps "$dest/package") ||
      die "release $ver still lacks $missing after npm ci; Pi settings were not changed and still load $pinned"
  fi
  node -e '
    const fs = require("node:fs"); const [file, root, ver] = process.argv.slice(1);
    const s = JSON.parse(fs.readFileSync(file, "utf8"));
    const rel = (p) => /steak-pi\/releases\/[^/]+\/package$/.test(typeof p === "string" ? p : p?.source ?? "");
    let hit = false;
    s.packages = (s.packages || []).map((p) => { if (!rel(p)) return p; hit = true;
      const src = typeof p === "string" ? p : p.source; const next = src.replace(/releases\/[^/]+\/package$/, "releases/" + ver + "/package");
      return typeof p === "string" ? next : { ...p, source: next }; });
    if (!hit) { console.error("no release-folder entry in " + file); process.exit(1); }
    const tmp = file + ".steak-pi-update.tmp"; fs.writeFileSync(tmp, JSON.stringify(s, null, 2) + "\n", { mode: 0o600 }); fs.renameSync(tmp, file);
  ' "$SETTINGS" "$root" "$ver" || die "could not re-point $SETTINGS at $ver"
  # The same machine runs Pi from several known agent directories: the default ~/.pi/agent and one per UltraTerm provider
  # account (~/.ultraterm/provider-accounts/<provider>/<account>/agent). Each has its own settings.json, so updating only the
  # caller's left the others on the old release (2026-11-04: 4 of 5 stayed behind). Re-point every KNOWN directory whose
  # settings pin a release folder under this same releases root; unknown directories elsewhere are never touched.
  others=0
  for known in "$HOME/.pi/agent/settings.json" "${ULTRATERM_HOME:-$HOME/.ultraterm}"/provider-accounts/*/*/agent/settings.json; do
    [ -f "$known" ] && [ ! -L "$known" ] || continue
    [ "$(CDPATH= cd -- "$(dirname -- "$known")" 2>/dev/null && pwd -P)" = "$(CDPATH= cd -- "$(dirname -- "$SETTINGS")" 2>/dev/null && pwd -P)" ] && continue
    if node -e '
      const fs = require("node:fs"); const path = require("node:path"); const [file, root, ver] = process.argv.slice(1);
      let s; try { s = JSON.parse(fs.readFileSync(file, "utf8")); } catch { process.exit(2); }
      const dir = path.dirname(file); let hit = false;
      const real = (p) => { try { return fs.realpathSync(p); } catch { return path.resolve(p); } };
      const realRoot = real(root);
      // Same releases root only: <root>/<version>/package, wherever the entry is written relative from.
      const under = (src) => real(path.dirname(path.dirname(path.resolve(dir, src.replace(/^~(?=\/)/, process.env.HOME))))) === realRoot;
      s.packages = (s.packages || []).map((p) => { const src = typeof p === "string" ? p : p?.source ?? "";
        if (!/steak-pi\/releases\/[^/]+\/package$/.test(src) || !under(src)) return p; hit = true;
        const next = src.replace(/releases\/[^/]+\/package$/, "releases/" + ver + "/package");
        return typeof p === "string" ? next : { ...p, source: next }; });
      if (!hit) process.exit(3);
      const tmp = file + ".steak-pi-update.tmp"; fs.writeFileSync(tmp, JSON.stringify(s, null, 2) + "\n", { mode: 0o600 }); fs.renameSync(tmp, file);
    ' "$known" "$root" "$ver" 2>/dev/null; then others=$((others + 1)); fi
  done
  [ "$others" -gt 0 ] && say "Also re-pointed $others other Pi agent setting$([ "$others" -eq 1 ] || echo s) on this machine to $ver."
  # PI_CODING_AGENT_DIR can point anywhere, including unavailable locations. There is no
  # complete registry of persistent pins, so neither process age nor a directory scan can
  # prove a release is unused. Retain every release, regardless of stale retirement markers.
  say "Steak Pi updated: $pinned -> $ver (existing releases retained). Restart Pi or run /reload."
}

cmd_update() {
  if [ "${1:-}" = "--check" ]; then
    TAG=$(latest_tag) || die "cannot reach GitHub to check for updates."
    [ -n "$TAG" ] || die "no published release found."
    # Compare with the release Pi loads when it is a release-folder install: a Homebrew CLI can be older than that folder, and
    # comparing the CLI made a successful update still read as "available" (2026-11-04).
    have=$VERSION
    if release_root >/dev/null 2>&1; then
      loaded=$(pi_spec) || loaded=""; loaded=${loaded%/package}; loaded=${loaded##*/}
      [ -n "$loaded" ] && have=$loaded
    fi
    if [ "${TAG#v}" = "$have" ]; then say "Steak Pi is up to date ($have)."; else say "Steak Pi ${TAG#v} is available (you have $have). Run: steak-pi update"; fi
    exit 0
  fi
  if root=$(release_root); then
    TAG=$(latest_tag) || die "cannot reach GitHub to find the latest release."
    [ -n "$TAG" ] || die "no published release found."
    loaded=$(pi_spec) || loaded=""; loaded=${loaded%/package}; loaded=${loaded##*/}
    if [ "${TAG#v}" = "$loaded" ]; then say "Steak Pi is up to date ($loaded)."; exit 0; fi
    update_release_folder "$root" "$TAG"
    exit 0
  fi
  if [ "$BREW_MODE" -eq 1 ]; then
    command -v brew >/dev/null 2>&1 || die "brew not found; this copy is Homebrew-managed."
    say "Upgrading Homebrew formula ${STEAK_PI_FORMULA:-steak-pi}..."
    brew update || die "brew update failed."
    brew upgrade "${STEAK_PI_FORMULA:-steak-pi}" || say "Homebrew reports no upgrade; continuing."
    NEW_LIBEXEC="$STEAK_PI_OPT/libexec"
    NEW_VERSION=$(pkg_version "$NEW_LIBEXEC") || die "upgraded formula package not found at $NEW_LIBEXEC"
    [ "$NEW_VERSION" = "$VERSION" ] && say "Steak Pi is up to date ($VERSION)." || say "Steak Pi upgraded: $VERSION -> $NEW_VERSION."
    current=$(pi_spec) || current=""
    case "$current" in
      */opt/steak-pi*)
        say "Pi points at the managed opt path ($current); it picks up the upgrade automatically."
        exit 0
        ;;
      "git:$REPO@"*)
        say "Re-pinning the pi package to v$NEW_VERSION:"
        say "  pi install git:$REPO@v$NEW_VERSION"
        exec pi install "git:$REPO@v$NEW_VERSION"
        ;;
      "")
        say "Pi-side integration is not installed. Run 'steak-pi install' to add it."
        exit 0
        ;;
      *)
        say "Unrecognized pi spec '$current'; leaving it untouched."
        exit 0
        ;;
    esac
  fi
  need_pi
  say "Resolving the latest Steak Pi release..."
  TAG=$(latest_tag) || die "cannot reach GitHub. Install a release manually: pi install $GIT_SPEC"
  [ -n "$TAG" ] || die "no published release found. Install manually: pi install $GIT_SPEC"
  say "Updating pi package to $TAG:"
  say "  pi install git:$REPO@$TAG"
  exec pi install "git:$REPO@$TAG"
}

cmd_status() {
  mode="git/npm install"; [ "$BREW_MODE" -eq 1 ] && mode="Homebrew (${STEAK_PI_FORMULA:-steak-pi})"
  say "steak-pi CLI      $VERSION  [$mode]"
  say "package root      $PKG_ROOT"
  say "pi settings       $SETTINGS"
  if current=$(pi_spec); then
    root="${current#git:$REPO@}"
    case "$current" in
      git:*) loc="$PI_DIR/git/$REPO";;
      /*) loc="$current";;
      *) loc="$PI_DIR/$current";;
    esac
    pver=$(pkg_version "$loc" 2>/dev/null || echo "unknown")
    say "pi integration    $current  (v$pver)"
  else
    say "pi integration    not installed — run 'steak-pi install'"
  fi
}

cmd_version() {
  say "steak-pi $VERSION (Pareto Cybernetics)"
}

cmd_remove() {
  need_pi
  if current=$(pi_spec); then
    say "Removing $current from pi..."
    exec pi remove "$current"
  fi
  say "No Steak Pi package found in $SETTINGS."
}

# Node runtime defaults for pi sessions. Each applies only when the operator
# has not set it. Measured on Pi 0.86 with the full package, scripted model:
#   compile cache      ~0.1 s faster start after the first launch, -10 MB
#   MALLOC_ARENA_MAX=2 fewer glibc arenas across libuv/V8 helper threads
#   semi-space 2 MB    smaller young generation; idle PSS -12%, 8-worker
#                      fan-out peak RSS 164 -> 125 MB, no measured slowdown
run_env() {
  if [ -z "${NODE_COMPILE_CACHE:-}" ] && [ -z "${NODE_DISABLE_COMPILE_CACHE:-}" ]; then
    NODE_COMPILE_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/steak-pi/node-compile-cache"
    export NODE_COMPILE_CACHE
  fi
  if [ -z "${MALLOC_ARENA_MAX:-}" ]; then
    MALLOC_ARENA_MAX=2
    export MALLOC_ARENA_MAX
  fi
  case " ${NODE_OPTIONS:-} " in
    *" --max-semi-space-size"*) ;;
    *) NODE_OPTIONS="--max-semi-space-size=2${NODE_OPTIONS:+ $NODE_OPTIONS}"; export NODE_OPTIONS;;
  esac
}

# --lean (first argument only) runs a one-shot leaf: no dispatch tool and no todo tool, so their schemas and guidance
# are not sent, and the working rules gain the short-reasoning line (measured to help the lean run only). Everything
# else (guards, working rules, compaction) stays on. STEAK_PI_WORK_RULES_BRIEF=0 keeps the line out.
LEAN_TOOLS="ultraterm_subagents,ultraterm_hub,todo"

cmd_run() {
  need_pi
  run_env
  if [ "${1:-}" = "--lean" ]; then
    shift
    STEAK_PI_WORK_RULES_BRIEF="${STEAK_PI_WORK_RULES_BRIEF:-1}"
    export STEAK_PI_WORK_RULES_BRIEF
    exec pi --exclude-tools "$LEAN_TOOLS" "$@"
  fi
  exec pi "$@"
}

cmd_usap_api() {
  command -v node >/dev/null 2>&1 || die "node not found on PATH."
  exec node "$PKG_ROOT/scripts/usap-claude-api.ts" "$@"
}

cmd_routing() {
  command -v node >/dev/null 2>&1 || die "node not found on PATH."
  [ "${1:-}" = check ] || die "usage: steak-pi routing check [routing.json]"
  shift
  exec node --no-warnings "$PKG_ROOT/src/routing-check.ts" "$@"
}

cmd_local() {
  command -v node >/dev/null 2>&1 || die "node not found on PATH."
  exec node --no-warnings "$PKG_ROOT/src/local/main.ts" "$@"
}

case "${1:-help}" in
  install) cmd_install;;
  update)  shift; cmd_update "$@";;
  status)  cmd_status;;
  version|--version|-V) cmd_version;;
  remove|uninstall) cmd_remove;;
  run) shift; cmd_run "$@";;
  usap-api) shift; cmd_usap_api "$@";;
  local) shift; cmd_local "$@";;
  routing) shift; cmd_routing "$@";;
  env) run_env; say "NODE_COMPILE_CACHE=$NODE_COMPILE_CACHE"; say "MALLOC_ARENA_MAX=$MALLOC_ARENA_MAX"; say "NODE_OPTIONS=$NODE_OPTIONS";;
  lean-args) say "--exclude-tools $LEAN_TOOLS";;
  help|--help|-h|*)
    say "usage: steak-pi <install|update|status|version|remove|run|usap-api|local|routing|finish-guard-hook|env>"
    say "  install   add Steak Pi to the pi coding agent (or re-point at this copy)"
    say "  update    install the latest release (--check only reports whether one is available)"
    say "  status    show installed versions and management mode"
    say "  version   print the CLI/package version"
    say "  remove    remove the pi-side package"
    say "  run       launch pi with Steak Pi's Node runtime defaults (args pass through; --lean first runs without the dispatch and todo tools)"
    say "  usap-api  run explicit Claude API USAP waves: admit | dispatch <wave.json> | resume <run-id>"
    say "  local     slot in a local GGUF model: add <gguf|owner/repo:quant> | start | stop | status | ensure <id> | release <id>"
    say "  routing   check [file]: validate routing.json exactly as every Pi turn does (run it before saving an edit)"
    say "  finish-guard-hook  Claude Code Stop hook: block a stop while requested work is open (reads hook JSON on stdin)"
    say "  env       print the runtime defaults 'run' would apply"
    [ -n "${1:-}" ] && [ "$1" != "help" ] && die "unknown command '$1'"
    ;;
esac
