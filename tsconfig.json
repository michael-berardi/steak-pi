  "include": ["extensions/**/*.ts", "src/**/*.ts", "test/**/*.ts", "packages/ultraterm-plan/src/**/*.ts", "packages/ultraterm-plan/pi/**/*.ts", "packages/ultraterm-plan/test/**/*.ts", "vitest.config.ts"]
}
