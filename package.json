{
  "name": "steak-pi",
  "version": "0.3.5",
  "description": "Steak Pi — a minimal native Pi companion with the UltraTerm Sub-Agent Protocol, todo, memory, verification, and deterministic compaction.",
  "license": "MIT",
  "author": "Implose Cybernetics",
  "repository": {
    "type": "git",
    "url": "https://github.com/michael-berardi/steak-pi.git"
  },
  "homepage": "https://github.com/michael-berardi/steak-pi#readme",
  "bugs": {
    "url": "https://github.com/michael-berardi/steak-pi/issues"
  },
  "files": [
    "CONTRIBUTING.md",
    "SECURITY.md",
    "benchmarks/usap/README.md",
    "benchmarks/usap/results/glm53-live-calibration-2026-09-04.md",
    "extensions",
    "src",
    "themes",
    "skills",
    "docs/AGENT-LIFECYCLE.md",
    "docs/COMPANION-UI.md",
    "docs/MODEL-ROUTING.md",
    "docs/THEME-PASS.md",
    "docs/ULTRATERM-SUBAGENT-PROTOCOL.md"
  ],
  "keywords": [
    "pi-package",
    "steak-pi",
    "coding-agent",
    "todo",
    "subagents",
    "orchestration",
    "ultraterm-subagent-protocol"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:tui": "./scripts/test-pi-tui-smoke.sh",
    "typecheck": "tsc --noEmit",
    "ui:simulate": "node --experimental-strip-types src/tui/simulator.ts",
    "verify": "npm run typecheck && npm test && npm run test:tui"
  },
  "pi": {
    "extensions": [
      "./extensions",
      "./extensions/ultracompress/index.ts"
    ],
    "themes": [
      "./themes"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0 <0.86.0",
    "@earendil-works/pi-tui": ">=0.85.0 <0.86.0",
    "typebox": ">=1.3.25 <2.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^26.4.1",
    "typebox": "^1.3.25",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
