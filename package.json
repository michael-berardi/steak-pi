{
  "name": "steak-pi",
  "version": "0.14.3",
  "bin": {
    "steak-pi": "bin/steak-pi"
  },
  "description": "Steak Pi — native subagents, deterministic compaction, verification, todo and a companion UI for Pi.",
  "license": "MIT",
  "author": "Pareto Cybernetics",
  "repository": {
    "type": "git",
    "url": "https://github.com/michael-berardi/steak-pi.git"
  },
  "homepage": "https://github.com/michael-berardi/steak-pi#readme",
  "bugs": {
    "url": "https://github.com/michael-berardi/steak-pi/issues"
  },
  "files": [
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "benchmarks/usap/README.md",
    "benchmarks/usap/results/glm53-live-calibration-2026-09-04.md",
    "benchmarks/usap/results/glm53-live-mirror-2026-09-09.md",
    "benchmarks/overhead/README.md",
    "extensions",
    "scripts/usap-claude-api.ts",
    "src",
    "themes",
    "skills",
    "docs/AGENT-LIFECYCLE.md",
    "docs/CLAUDE-CODE.md",
    "docs/COMPANION-UI.md",
    "docs/assets",
    "docs/MODEL-ROUTING.md",
    "docs/PROFILES.md",
    "docs/THEME-PASS.md",
    "docs/ULTRATERM-SUBAGENT-PROTOCOL.md",
    "docs/CLAUDE-API-ROUTE.md",
    "docs/OPUS-5-5.md",
    "docs/opus-5-5.models.json"
  ],
  "keywords": [
    "pi-package",
    "steak-pi",
    "coding-agent",
    "todo",
    "subagents",
    "orchestration",
    "ultraterm-subagent-protocol"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "usap:claude-api": "node scripts/usap-claude-api.ts",
    "test:tui": "./scripts/test-pi-tui-smoke.sh && ./scripts/test-pi-startup-paste.sh",
    "typecheck": "tsc --noEmit",
    "ui:simulate": "node --experimental-strip-types src/tui/simulator.ts",
    "verify": "npm run typecheck && npm test && npm run test:tui"
  },
  "pi": {
    "extensions": [
      "./extensions",
      "./extensions/ultracompress/index.ts",
      "./extensions/skill-catalog-lite/index.ts",
      "./extensions/claude-code/index.ts"
    ],
    "themes": [
      "./themes"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": ">=1.3.25 <2.0.0"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "8.12.3"
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/node": "^26.4.1",
    "typebox": "^1.3.25",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
